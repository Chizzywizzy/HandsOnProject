generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
  role     String  @default("Member")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String   @default("Department")
  leaderId  Int?
  createdAt DateTime @default(now())
  members   Member[]
}

model Member {
  id           Int         @id @default(autoincrement())
  name         String
  email        String?     @unique
  phone        String?
  dateJoined   DateTime?
  status       String      @default("Active")
  archived     Boolean     @default(false)
  skills       String?
  roles        String?
  photoUrl     String?
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  groupName    String?
  createdAt    DateTime    @default(now())
}

model Visitor {
  id         Int        @id @default(autoincrement())
  name       String
  contact    String?
  source     String?
  notes      String?
  visitDate  DateTime   @default(now())
  returning  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  followUps  FollowUp[]
}

model FollowUp {
  id        Int      @id @default(autoincrement())
  visitorId Int
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignee  String?
  dueDate   DateTime?
  status    String   @default("Pending")
  outcome   String?
  createdAt DateTime @default(now())
}

model AttendanceSession {
  id           Int                @id @default(autoincrement())
  date         DateTime           @default(now())
  service      String
  departmentId Int?
  groupName    String?
  eventTitle   String?
  createdAt    DateTime           @default(now())
  records      AttendanceRecord[]
}

model AttendanceRecord {
  id        Int               @id @default(autoincrement())
  sessionId Int
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  Int?
  visitorId Int?
  present   Boolean           @default(true)
}

model Event {
  id          Int             @id @default(autoincrement())
  title       String
  date        DateTime
  time        String?
  venue       String?
  description String?
  coordinator String?
  status      String          @default("Planned")
  createdAt   DateTime        @default(now())
  attendees   EventAttendee[]
  notes       EventNote[]
}

model EventAttendee {
  id       Int    @id @default(autoincrement())
  eventId  Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId Int?
  name     String?
}

model EventNote {
  id      Int      @id @default(autoincrement())
  eventId Int
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text    String
  createdAt DateTime @default(now())
}

model Task {
  id              Int           @id @default(autoincrement())
  title           String
  description     String?
  owner           String?
  departmentId    Int?
  priority        String        @default("Medium")
  dueDate         DateTime?
  status          String        @default("Not Started")
  completionNotes String?
  recurrence      String?       @default("None")
  createdAt       DateTime      @default(now())
  comments        TaskComment[]
}

model TaskComment {
  id      Int      @id @default(autoincrement())
  taskId  Int
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text    String
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  channel   String
  to        String
  body      String
  status    String   @default("sent")
  createdAt DateTime @default(now())
}