# Copy to .env for local development. Never commit real secrets.
# Database: Netlify Database (Postgres). `netlify dev` injects NETLIFY_DB_URL
# automatically; to use your own local Postgres instead, set it here:
# NETLIFY_DB_URL="postgresql://USER:PASSWORD@localhost:5432/cmap"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Google Gemini (optional; enables Reports → Generate AI Summary)
# Get a key at https://aistudio.google.com (Get API key). Free tier available.
GEMINI_API_KEY=""

# ---- Production (Netlify) — set in dashboard, NOT in this file ----
# NETLIFY_DB_URL is provided automatically by Netlify Database — do not set it.
# NEXTAUTH_URL="https://<your-site>.netlify.app"
# NEXTAUTH_SECRET="<generate: openssl rand -base64 32>"
# GOOGLE_CLIENT_ID=""       # optional; Calendar sync
# GOOGLE_CLIENT_SECRET=""   # optional; Calendar sync
# GOOGLE_REFRESH_TOKEN=""   # optional; Calendar sync
# TG_TOKEN=""               # optional; Telegram alerts
# TG_CHAT_ID=""             # optional; Telegram alerts
